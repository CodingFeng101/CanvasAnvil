FROM node:20-alpine AS build

WORKDIR /app/pptist-lab
ENV HUSKY=0
COPY pptist-lab/package.json pptist-lab/package-lock.json ./
RUN npm ci

COPY pptist-lab ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY deploy/docker/pptist-lab.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/pptist-lab/dist /usr/share/nginx/html

EXPOSE 80
